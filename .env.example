# Copy to .env (git-ignored) and fill in. Values here are read as Spring properties / placeholders.

# Mail (https://mailtrap.io/ provides a free SMTP sandbox)
MAIL_PROTOCOL=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# MySQL, used by the dev, qa, staging and production profiles
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sbat
DB_USERNAME=sbat
DB_PASSWORD=

# Security (required in production)
# JWT_KEY_STORE=file:/run/secrets/jwt.p12
# JWT_KEY_STORE_PASSWORD=
# JWT_KEY_ALIAS=sbat
# REMEMBER_ME_KEY=

# Home page branding
SITE_LOGO=/images/map.svg
SITE_INITIALS=SBAT
SITE_TITLE=Spring Boot Application Template
